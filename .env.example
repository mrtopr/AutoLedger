# ==============================================================================
# TradeLedger ERP — Environment Configuration & Production SRE Template
# ==============================================================================

NODE_ENV=production
APP_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.example.com
JWT_SECRET=generate-a-secure-random-64-character-secret-in-production

# Neon Serverless PostgreSQL / Cloud Database (SSL required in production)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Razorpay Payment Gateway & Webhook (0-cost test/sandbox mode supported)
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Email OTP Authentication
# Option A: Gmail SMTP (No custom domain needed - sends to any email address)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Option B: Resend API (Free tier: https://resend.com - requires verified domain for all recipients)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="TradeLedger <onboarding@resend.dev>"

# SRE & Reliability Controls
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=""
LOG_LEVEL="INFO"
TRUST_PROXY=true

# Distributed Rate Limiter (Upstash Redis REST - Optional for multi-instance deployments)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Security Gate Toggles (Strictly false in production)
ALLOW_TEST_OTP=false
ALLOW_DEV_PASSWORDS=false
