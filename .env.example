NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://x-autoledger.vercel.app
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Neon Serverless PostgreSQL
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Razorpay Payment Gateway & Webhook (0-cost test/sandbox mode supported)
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="autoledger_webhook_secret_2026"

# Firebase Phone OTP Authentication
FIREBASE_API_KEY="AIzaSy..."
FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="123456789"
FIREBASE_APP_ID="1:123456789:web:abcdef"
